{
  "manifest_version": 3,
  "name": "TweetWiper",
  "version": "1.0.1",
  "description": "Deletes every post, reply and repost on your own X account, using the X tab you are already signed into.",
  "permissions": ["storage", "unlimitedStorage", "activeTab"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*"],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "TweetWiper", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
